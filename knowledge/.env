# Hugging Face 缓存路径
HF_HOME=./.huggingface-cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/


# mineru api以及url处理地址！
MINERU_API_TOKEN=sk-VvQwGVOedQrMmw4QAtKjfbLx45Odq92oSfN13iNwHKKj2vCw
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
DASHSCOPE_API_KEY=sk-244c9556e0194deeb30099d44af40439
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数
LLM_DEFAULT_TEMPERATURE=0.1

# VLM视觉语言模型
VL_MODEL=qwen3-vl-flash
# 商品名识别相关模型
ITEM_MODEL=qwen-flash
# 知识图谱模型
KG_MODEL=qwen-flash

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=./models/bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cpu
## 是否使用半精度
#BGE_FP16=True
# BGE-M3是否开启FP16半精度推理，1=开启（GPU加速更高效），0=关闭（兼容低版本GPU/CPU）
BGE_FP16=0
# BGE 重排序模型路径
BGE_RERANKER_LARGE=./models/bge-reranker-v2-m3
# 重排序模型设备
BGE_RERANKER_DEVICE=cpu
# 重排序模型半精度
BGE_RERANKER_FP16=0

# MinerU / Hugging Face LayoutReader local snapshot
LAYOUT_READER_PATH=./.huggingface-cache/hub/models--hantian--layoutreader/snapshots/629be376d86fbab624ddc4020804a4e93b5515bc
# 项目名称诊断标志
ITEM_NAME_DIAG=1





# ====================
# Embedding General
# ====================
# 嵌入向量维度
EMBEDDING_DIM=1536
# 嵌入模型名称
