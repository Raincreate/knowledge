# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式
MODELSCOPE_OFFLINE=0
# ModelScope 模型缓存路径
